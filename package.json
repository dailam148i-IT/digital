{
  "name": "digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint",
    "e2e": "npm run e2e:dev",
    "e2e:dev": "node scripts/run-dev-e2e.mjs",
    "e2e:prod": "npm run build && node scripts/run-prod-e2e.mjs",
    "e2e:ui": "playwright test --ui",
    "audit": "npm audit --audit-level=moderate",
    "verify:quick": "npm run typecheck && npm run lint",
    "verify": "npm run test && npm run build && npm run e2e",
    "verify:release": "npm run verify:quick && npm run e2e:prod && npm run audit"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0 <12.0.0"
  }
}
