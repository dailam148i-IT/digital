# Public site URL used by metadata and deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integration mode is inferred from credentials. Missing credentials keep the app in mock mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# payOS/VietQR production checkout remains disabled until all keys are configured and webhook proof exists.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
